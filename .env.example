# 复制为 .env 后再填真实值；.env 已被 .gitignore 排除，绝不提交。
# 下面全部是占位符，不是真实密钥。

# --------------------------------------------------------------------- 应用
APP_NAME=AI Task Manager
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# --------------------------------------------------------------------- 安全
# JWT 签名密钥：生产环境必须设置为至少 32 字符的随机串（例如 python -c "import secrets; print(secrets.token_hex(32))"）。
# 留空时开发模式会自动生成随机密钥（重启后已登录状态失效）。
# SECRET_KEY=replace-me-with-random-64-hex-chars
JWT_EXPIRE_MINUTES=1440

# --------------------------------------------------------------------- 数据库
# 默认 SQLite（data/app.db）；可选 PostgreSQL：
#   DATABASE_URL=postgresql+psycopg://user:password@host:5432/aitask
# DATABASE_URL=sqlite:///data/app.db

# --------------------------------------------------------------------- AI（可选）
# 三项齐全才启用 AI 功能（OpenAI 兼容接口）；不配置时普通任务管理完全可用。
# 下面以智谱 GLM 为例，base_url 是公开文档地址，不是密钥。
# AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_API_KEY=replace-me
# AI_MODEL=glm-4-flash
AI_TIMEOUT_SECONDS=30
